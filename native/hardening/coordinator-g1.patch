+template<class Store>
+bool config_codecs_valid(Store &config, bool test_dc, bool require_roles = true) {
+  bool valid = true;
+  g1::FixedRoleGroup roles(test_dc);
+  config.for_each([&](Slice name, Slice value) {
+    auto key = borrowed(name), bytes = borrowed(value);
+    valid &= g1::config_option_entry_codec_valid(key, bytes);
+    roles.observe(key, bytes);
+  });
+  // Selected exact24 absence + five fixed roles only. Other option domains,
+  // default/cleanup rules and cross-fields remain an integration blocker.
+  return valid && roles.valid(require_roles);
+}
