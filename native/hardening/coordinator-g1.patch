+void TdDb::seal_authorized(Promise<AuthorizationSealResult> promise) {
+  using Store = BinlogKeyValue<ConcurrentBinlog>;
+  auto context = parameters_.g1_context_;
+  if (!context || !binlog_pmc_ || !config_pmc_ || !binlog_ || !context->validate() ||
+      context->state() != g1::StorageContext::State::AwaitingAuthorization) {
+    if (context) { context->stop(); }
+    return promise.set_error(refused());
+  }
+  auto captured = Store::try_snapshot_pair(binlog_pmc_, config_pmc_);
+  if (captured.is_error()) {
+    captured.move_as_error().ignore(); context->stop(); return promise.set_error(refused());
+  }
+  auto views = captured.move_as_ok();
+  if (!views) { return promise.set_value(AuthorizationSealResult::Busy); }
+  if (!personal_authorized(views.first) || !config_codecs_valid(views.second, parameters_.is_test_dc_) ||
+      !identity_pair_valid(views.first, views.second)) {
+    views = Store::SnapshotPair(); // No outward callbacks while any guard is held.
+    context->stop(); return promise.set_error(refused());
+  }
+  const auto pmc_stamp = views.first.stamp(), config_stamp = views.second.stamp();
+  const auto generation = context->generation();
+  views = Store::SnapshotPair(); // Release BOTH guards before native actor sync.
+  binlog_->force_sync_handoff(PromiseCreator::lambda(
+      [context = std::move(context), generation, pmc = binlog_pmc_, config = config_pmc_, writer = binlog_,
+       test_dc = parameters_.is_test_dc_, pmc_stamp, config_stamp, promise = std::move(promise)](Result<Unit> synced) mutable {
+        // This success continuation is invoked by an explicitly deferred turn on
+        // the actual binlog actor, not inline or on the separately running Td actor.
+        if (synced.is_error()) { synced.move_as_error().ignore(); context->stop(); return promise.set_error(refused()); }
+        auto finalized = [&]() -> Result<AuthorizationSealResult> {
+          if (!writer || generation != context->generation() || !context->validate() ||
+              context->state() != g1::StorageContext::State::AwaitingAuthorization) { return refused(); }
+          TRY_RESULT(final_views, Store::try_snapshot_pair(pmc, config));
+          if (!final_views) { return AuthorizationSealResult::Busy; }
+          // Current semantic invalidity is refusal even when the captured stamps
+          // changed. Healthy Changed must never hide missing/wrong roles or the
+          // already-selected auth, identity and retired-name refusal contracts.
+          if (!personal_authorized(final_views.first) || !config_codecs_valid(final_views.second, test_dc) ||
+              !identity_pair_valid(final_views.first, final_views.second)) { return refused(); }
+          if (!final_views.first.matches(pmc_stamp) || !final_views.second.matches(config_stamp)) {
+            return AuthorizationSealResult::Changed;
+          }
+          // Fixed native-only continuation: no G(), actor wait or external callback.
+          // Writer maintenance is excluded by this actor's serialization. Native
+          // Ready is the guarded internal authority point, NOT full schema acceptance.
+          TRY_STATUS(context->seal_after_authorization_sync());
+          return AuthorizationSealResult::Ready;
+        }(); // All borrowed guards are gone before the outward result is completed.
+        if (finalized.is_error()) { finalized.move_as_error().ignore(); context->stop(); return promise.set_error(refused()); }
+        promise.set_value(finalized.move_as_ok());
+      }), "TGCLI_G1_FIRST_AUTHORIZATION");
+}
