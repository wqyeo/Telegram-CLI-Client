+Status TdDb::initialize_g1_new_main_dc(int32 actual_main_dc) {
+  auto context = parameters_.g1_context_;
+  if (!context || !context->is_new() ||
+      context->state() != g1::StorageContext::State::AwaitingAuthorization ||
+      !context->validate() || !binlog_pmc_ || !binlog_ ||
+      !personal_identity_valid(*binlog_pmc_) || actual_main_dc < 1 || actual_main_dc > 1000) {
+    return refused();
+  }
+  // Caller holds the native dispatcher mutex through this whole operation.
+  // Existing native state is checked, never canonicalized/repaired/overwritten.
+  const auto canonical = std::to_string(actual_main_dc);
+  if (binlog_pmc_->isset("main_dc_id")) {
+    return binlog_pmc_->get("main_dc_id") == canonical ? Status::OK() : refused();
+  }
+  binlog_pmc_->set("main_dc_id", canonical);
   return Status::OK();
 }
 
