+  if (!context) { return promise.set_error(refused()); }
+  auto failure = ScopeExit() + [&] { context->stop(); };
+  TRY_STATUS_PROMISE(promise, check_parameters(parameters));
+  OpenedDatabase result;
+  // Real ownership on every early return. PMC shared handles are non-owning
+  // until transfer, unlike the old custom deleter which only saved a raw ptr.
+  auto owner = make_unique<Binlog>();
+  auto binlog = std::shared_ptr<Binlog>(owner.get(), [](Binlog *) {});
+  auto pmc = make_unique<BinlogKeyValue<Binlog>>();
+  auto config = make_unique<BinlogKeyValue<Binlog>>();
+  pmc->external_init_begin(static_cast<int32>(LogEvent::HandlerType::BinlogPmcMagic));
+  config->external_init_begin(static_cast<int32>(LogEvent::HandlerType::ConfigPmcMagic));
+  TRY_STATUS_PROMISE(promise, init_binlog(*binlog, context->binlog_path(), *pmc, *config,
+                                         std::move(parameters.encryption_key_)));
+  bool new_nonempty = false;
+  if (context->is_new()) {
+    pmc->for_each([&](Slice, Slice) { new_nonempty = true; });
+    config->for_each([&](Slice, Slice) { new_nonempty = true; });
+  }
+  if (pmc->isset("sqlite_key") || pmc->isset("auth_is_bot") ||
+      (context->is_new() && new_nonempty) ||
+      (!context->is_new() && (!personal_authorized(*pmc) || !config_codecs_valid(*config, parameters.is_test_dc_) ||
+                              !identity_pair_valid(*pmc, *config)))) {
+    return promise.set_error(refused());
+  }
+  // No SQL initialization/key generation/conversion, mkdir, repair or retry.
+  // Per-PMC-value semantic/format audit remains an explicit integration blocker;
+  // this draft's checks do not certify all native values or an account engine.
+  TRY_STATUS_PROMISE(promise, context->finish_open());
+  auto concurrent_pmc = std::make_shared<BinlogKeyValue<ConcurrentBinlog>>();
+  concurrent_pmc->external_init_begin(pmc->get_magic());
+  concurrent_pmc->external_init_handle(std::move(*pmc));
+  auto concurrent_config = std::make_shared<BinlogKeyValue<ConcurrentBinlog>>();
+  concurrent_config->external_init_begin(config->get_magic());
+  concurrent_config->external_init_handle(std::move(*config));
+  pmc.reset(); config.reset(); binlog.reset();
+  auto concurrent = std::make_shared<ConcurrentBinlog>(std::move(owner));
+  concurrent_pmc->external_init_finish(concurrent);
+  concurrent_config->external_init_finish(concurrent);
+  auto db = make_unique<TdDb>();
+  db->parameters_ = std::move(parameters);
+  db->binlog_pmc_ = std::move(concurrent_pmc);
+  db->config_pmc_ = std::move(concurrent_config);
+  db->binlog_ = std::move(concurrent);
+  result.database = std::move(db);
+  failure.dismiss();
+  promise.set_value(std::move(result));
+}
+TdDb::TdDb() = default;
+TdDb::~TdDb() { LOG_IF(ERROR, binlog_ != nullptr) << "TGCLI_G1_DATABASE_NOT_CLOSED"; }
+Status TdDb::check_parameters(Parameters &parameters) {
+  if (!parameters.g1_context_) { return refused(); }
+  return parameters.g1_context_->prepare_open(parameters.encryption_key_, parameters.database_directory_,
+      parameters.files_directory_, parameters.is_test_dc_, parameters.use_file_database_,
+      parameters.use_chat_info_database_, parameters.use_message_database_);
+}
