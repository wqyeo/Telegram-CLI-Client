+void TdDb::change_key(DbKey, Promise<> promise) {
+  promise.set_error(Status::Error(400, "TGCLI_G1_BINLOG_KEY_ROTATION_REFUSED"));
+}
+Status TdDb::destroy(const Parameters &parameters) {
+  if (parameters.g1_context_) { parameters.g1_context_->stop(); }
+  return Status::Error(400, "TGCLI_G1_DESTRUCTION_REFUSED");
