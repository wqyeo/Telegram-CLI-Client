+  if (!personal_identity_valid(pmc)) { return false; }
+  const auto main = pmc.get("main_dc_id");
+  const auto main_dc = g1::canonical_main_dc(borrowed(main));
+  if (main_dc == 0) { return false; }
+  bool valid = true, primary_found = false, main_found = false;
+  // BinlogKeyValue::for_each retains its map lock; borrowed values never escape.
+  // Do not recursively call pmc.get/isset inside this callback.
+  pmc.for_each([&](Slice key, Slice value) {
+    auto name = borrowed(key), bytes = borrowed(value);
+    if (name == "main_dc_id") { main_found = bytes == borrowed(main); valid &= main_found; }
+    if (name == "server_time_difference") { valid &= g1::server_time_difference_valid(bytes); }
+    if (name == "config_expire") { valid &= g1::canonical_int32(bytes); }
+    const auto role = g1::persisted_dc_role(name, main_dc);
+    if (role == g1::PersistedDcRole::Malformed) { valid = false; }
+    if (role == g1::PersistedDcRole::PrimaryAuth || role == g1::PersistedDcRole::AuxiliaryAuth) {
+      const bool primary = role == g1::PersistedDcRole::PrimaryAuth;
+      primary_found |= primary;
+      valid &= g1::persisted_auth_key_valid(bytes, primary);
     }
-    if (since_last_open > 0 && since_last_open < 1e12) {
-      events.since_last_open = static_cast<int64>(since_last_open);
+    if (role == g1::PersistedDcRole::Salt) { valid &= g1::persisted_salts_valid(bytes); }
+  });
+  return valid && primary_found && main_found;
+}
