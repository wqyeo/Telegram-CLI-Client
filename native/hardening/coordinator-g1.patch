+void Td::stop_g1() {
+  if (td_options_.g1_context) { td_options_.g1_context->stop(); }
+  g1_ready_published_ = false;
+  if (state_ == State::Run && !close_flag_) {
+    // Stop dispatch before close/save and preserve a terminal native marker.
+    // No destroy_auth_keys RPC, logout, database deletion or reauthentication.
+    G()->net_query_dispatcher().stop();
+    G()->td_db()->get_binlog_pmc()->set("auth", "destroy");
+  }
+  close_impl(false);
+}
+
+void Td::on_g1_ready(Result<TdDb::AuthorizationSealResult> result) {
+  g1_seal_pending_ = false;
+  if (result.is_error()) { result.error().ignore(); return stop_g1(); }
+  if (close_flag_ || !td_options_.g1_context || !td_options_.g1_context->validate()) { return stop_g1(); }
+  if (result.move_as_ok() != TdDb::AuthorizationSealResult::Ready) {
+    // Healthy contention/change is NOT READY. No automatic resync/backoff/wait
+    // budget selected: that pending workflow remains a production fence blocker.
+    return;
+  }
+  if (!td_options_.g1_context->private_data_allowed()) { return stop_g1(); }
+  g1_ready_published_ = true;
+  send_update(td_api::make_object<td_api::updateAuthorizationState>(
+      td_api::make_object<td_api::authorizationStateReady>()));
+}
